+                continue
+            rgb = fr.reformat(width=cell_w, height=cell_h, format="rgb24").to_ndarray()
+            img = QImage(rgb.data, cell_w, cell_h, rgb.strides[0], QImage.Format_RGB888).copy()
+            t = fr.time if fr.time is not None else t
+            break
+        shots.append((t, img))
