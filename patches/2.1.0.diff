+    p.drawText(QRectF(pad * 2, 44, W - 4 * pad, 28), Qt.AlignLeft | Qt.AlignVCenter, info)
+    ft = QFont("Consolas", 11, QFont.Bold)
+    for i, (t, img) in enumerate(shots):
+        x = pad + (i % cols) * (cell_w + pad)
